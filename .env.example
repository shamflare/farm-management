DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-characters-long
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
DATABASE_URL=postgresql://farm:farm@localhost:5432/farm
FARM_TIMEZONE=Asia/Damascus
CORS_ORIGINS=http://localhost:3000

# --- deployment only ---------------------------------------------------
# Origins allowed to submit forms to the Django admin over HTTPS.
CSRF_TRUSTED_ORIGINS=
# Password given to the seeded demo logins on every boot. Leave empty to keep
# whatever the seed set.
DEMO_PASSWORD=
