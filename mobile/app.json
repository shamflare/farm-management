{
  "expo": {
    "name": "زاد",
    "slug": "zadfarm",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "zadfarm",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F2A1D"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.zadfarm.app"
    },
    "android": {
      "package": "net.zadfarm.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0F2A1D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F2A1D",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://zadfarm.net/api/v1",
      "router": {},
      "eas": {
        "projectId": "9bcc3110-bcda-43fc-a529-5616637fef72"
      }
    },
    "owner": "zadfarms-team"
  }
}
