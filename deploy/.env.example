# انسخه إلى deploy/.env على الخادم واملأ القيم. لا تضعه في Git أبدًا.
#
#   cp deploy/.env.example deploy/.env && nano deploy/.env

# الدومين الذي يشير إلى هذا الخادم (بلا https وبلا www)
DOMAIN=zadfarm.net
# بريد تصلك عليه تنبيهات انتهاء الشهادة من Let's Encrypt
ACME_EMAIL=you@example.com

# --- أسرار: ولّدها ولا تشاركها --------------------------------------------
# openssl rand -base64 48
DJANGO_SECRET_KEY=
# openssl rand -base64 24
POSTGRES_PASSWORD=
# كلمة مرور دخولك أنت إلى اللوحة (١٢ حرفًا فأكثر)
OWNER_PASSWORD=

# --- المزرعة وحسابك -------------------------------------------------------
FARM_NAME=مزرعة زاد
FARM_SLUG=zadfarm
OWNER_USERNAME=owner
OWNER_NAME=صاحب المزرعة
FARM_TIMEZONE=Asia/Damascus

# اجعلها 1 مؤقتًا إن نسيت كلمة المرور: تُعاد إلى OWNER_PASSWORD عند أول إقلاع.
# أعدها إلى 0 بعدها، وإلا أُعيدت في كل تشغيل.
OWNER_PASSWORD_RESET=0

# --- القاعدة (الافتراضي يكفي) ---------------------------------------------
POSTGRES_DB=farm
POSTGRES_USER=farm
